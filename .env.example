# Copy to .env and populate. .env is gitignored
#
# Account identifier, e.g. ab12345.ap-southeast-1
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=

# externalbrowser opens SSO and keeps secrets out of the environment entirely.
# Use 'snowflake' with SNOWFLAKE_PASSWORD only if browser auth is unavailable.
SNOWFLAKE_AUTHENTICATOR=externalbrowser
# SNOWFLAKE_PASSWORD=

SNOWFLAKE_ROLE=FR_F1_ENGINEER
SNOWFLAKE_WAREHOUSE=WH_F1_LOAD
SNOWFLAKE_DATABASE=F1_DB
SNOWFLAKE_SCHEMA=RAW
